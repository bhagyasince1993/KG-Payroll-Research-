                    │  Employee  │
                    └─────┬──────┘
                          │ hasRole
                          ▼
                    ┌────────────┐
                    │    Role    │
                    └────────────┘

         residesIn / worksIn
                 │
                 ▼
        ┌─────────────────┐
        │TaxJurisdiction  │
        └────────┬────────┘
                 │ effectiveOn
                 ▼
        ┌─────────────────┐
        │ComplianceRule   │◄──── overrides ────┐
        └────────┬────────┘                    │
                 │ subjectTo                   │
                 ▼                             │
        ┌─────────────────┐                    │
        │   PayEvent      │────────────────────┘
        └──────┬──────────┘
               │ computedUnder
               ▼
        ┌─────────────────┐
        │    PayRule      │
        └─────────────────┘

               │ deductedFrom
               ▼
        ┌─────────────────┐
        │   Deduction     │
        └─────────────────┘

               │ triggersAudit
               ▼
        ┌─────────────────┐
        │  AuditEvent     │
        └─────────────────┘
